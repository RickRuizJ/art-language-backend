{
  "name": "art-language-campus-backend",
  "version": "1.0.0",
  "description": "Backend API for Art & Language Campus LMS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/config/migrate.js",
    "test": "jest",
    "test:integration": "npm run test:api --prefix tests/system",
    "check:readiness": "node scripts/check-readiness.js",
    "test:security": "npm run test:security --prefix tests/system",
    "test:startup": "npm run test:startup --prefix tests/system"
  },
  "keywords": [
    "lms",
    "education",
    "api"
  ],
  "author": "Art & Language Campus",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "dottie": "^2.0.7",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "proxy-addr": "^2.0.8",
    "underscore": "^1.13.8",
    "uuid": "$uuid"
  }
