NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
JWT_SECRET=cadena-larga-y-aleatoria
FRONTEND_URL=https://tu-campus.vercel.app
# Orígenes extra separados por coma (previews de Vercel, dominio propio)
# CORS_ORIGINS=https://otro.vercel.app

# Subida de archivos: sin estas 3 variables la subida responde 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcionales
# AUTO_MIGRATE=false      # por defecto las migraciones se aplican al arrancar
# RATE_LIMIT_MAX=1000     # peticiones por IP cada 15 min
# AUTH_RATE_LIMIT_MAX=40  # logins/registros por IP cada 15 min
