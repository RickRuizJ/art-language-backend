# Copy values into the backend host's secret settings. Never commit a real .env.
NODE_ENV=production
PORT=5000
# Complete PostgreSQL URL from your provider; keep it private.
DATABASE_URL=
# At least 32 random characters. Rotating this signs out all sessions.
JWT_SECRET=
JWT_EXPIRE=7d
# Frontend HTTPS origin only, without a path, query or hash.
FRONTEND_URL=
# Add explicit HTTPS origins separated by commas when needed.
CORS_ORIGINS=
# Render normally has one trusted reverse-proxy hop. Verify your actual topology.
# Default is 0; do not trust arbitrary client-supplied X-Forwarded-For headers.
TRUST_PROXY_HOPS=0
# TLS always validates certificates in production. Supply your provider's CA only if needed.
DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...provider CA...-----END CERTIFICATE-----
# DATABASE_SSL_CA_FILE=/secure/path/provider-ca.pem
# Run npm run migrate in a separate controlled deployment step. Default is false.
AUTO_MIGRATE=false
RATE_LIMIT_MAX=6000
AUTH_RATE_LIMIT_MAX=40
LOGIN_ACCOUNT_MAX=10
RECOVERY_EMAIL_HOURLY_MAX=3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ONE general teacher registration password, already chosen by the owner.
TEACHER_REGISTRATION_PASSWORD=
# Resend requires a verified sender/domain. The server processes its durable queue every 10 seconds.
RESEND_API_KEY=
EMAIL_FROM=

# Transactional email provider. Set sender to use the Sender account already used by Art & Language.
EMAIL_PROVIDER=sender
SENDER_API_TOKEN=
EMAIL_FROM=services@artandlanguage.com.mx
EMAIL_FROM_NAME=Art & Language
# RESEND_API_KEY remains optional and is used only when EMAIL_PROVIDER=resend
